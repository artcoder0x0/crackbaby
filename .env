# Set to "paid" to allow access, "unpaid" to block immediately
VPS_STATUS=paid

# Date super admin last confirmed payment (YYYY-MM-DD)
VPS_PAID_DATE=2026-06-05

# How many days one paid cycle lasts (default: 30)
VPS_CYCLE_DAYS=30